    "keybindings": [
      {
        "command": "peachq.execute.selectedQuery",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "resourceFilename =~ /\\.(?:q|quke|sql)$/i && !peachq.deferringToKx"
      },
      {
        "command": "peachq.execute.selectedQuery",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "notebookType == 'peachq-notebook' && notebookEditorFocused && editorTextFocus && notebookCellType == 'code' && !peachq.deferringToKx"
      },
      {
        "command": "peachq.execute.fileQuery",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "resourceFilename =~ /\\.(?:q|sql)$/i && !peachq.deferringToKx"
      },
      {
        "command": "peachq.scratchpad.python.run",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "resourceFilename =~ /\\.(?:py)$/i && !peachq.deferringToKx"
      },
      {
        "command": "peachq.scratchpad.python.run.file",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "resourceFilename =~ /\\.(?:py)$/i && !peachq.deferringToKx"
      },
      {
        "command": "peachq.scratchpad.editor.reset",
        "key": "ctrl+shift+delete",
        "mac": "cmd+shift+delete",
        "when": "resourceFilename =~ /\\.(?:q|py|sql|kxnb)$/i && !peachq.deferringToKx"
      },
      {
        "command": "peachq.file.populateScratchpad",
        "key": "alt+ctrl+shift+p",
        "mac": "alt+cmd+shift+p",
        "when": "resourceFilename =~ /\\.(?:q|py|sql)$/i && !peachq.deferringToKx"
      },
      {
        "command": "peachq.execute.block",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "resourceFilename =~ /\\.(?:q)$/i && !peachq.deferringToKx"
      },
      {
        "command": "peachq.toggleParameterCache",
        "key": "ctrl+shift+y",
        "mac": "cmd+shift+y",
        "when": "resourceFilename =~ /\\.(?:q)$/i && !peachq.deferringToKx"
      },
      {
        "command": "peachq.file.pickTarget",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "resourceFilename =~ /\\.(?:q|py|sql)$/i && !peachq.deferringToKx"
      }
    ],
