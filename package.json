{
  "name": "peachq",
  "displayName": "peachq",
  "description": "q language support: run, chart and lint q against any kdb+ process, or with built-in peachq — no licence needed",
  "publisher": "peachq",
  "version": "1.21.0-rc",
  "icon": "resources/images/peachq-logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanhamilton/kx-vscode.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "q",
    "kdb+",
    "peachq",
    "qlang",
    "kdb"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:sql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "peachq",
      "properties": {
        "peachq.servers": {
          "type": "object",
          "description": "kdb servers for explorer",
          "scope": "machine"
        },
        "peachq.insights": {
          "deprecationMessage": "This setting is deprecated, use peachq.insightsEnterpriseConnections instead",
          "type": "object",
          "description": "kdb insights for explorer",
          "scope": "machine"
        },
        "peachq.insightsEnterpriseConnections": {
          "type": "object",
          "description": "kdb insights enterprise connections for explorer",
          "scope": "machine"
        },
        "peachq.hideInstallationNotification": {
          "type": "boolean",
          "description": "Hide notification for installation path, after first install",
          "scope": "machine",
          "deprecationMessage": "This setting is deprecated, use peachq.neverShowQInstallAgain instead"
        },
        "peachq.hideDetailedConsoleQueryOutput": {
          "type": "boolean",
          "description": "Hide detailed console query output",
          "default": true,
          "scope": "machine",
          "deprecationMessage": "This setting is deprecated, use peachq.hideSourceExpressions instead"
        },
        "peachq.hideSourceExpressions": {
          "type": "boolean",
          "description": "When disabled, the console shows all evaluated expressions, intermediate steps, and results from your query. Enable this to streamline logs and reduce visual clutter when running simple or production-ready queries.",
          "default": true,
          "scope": "machine"
        },
        "peachq.results.grid": {
          "type": "string",
          "enum": [
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Tables, dictionaries and keyed tables also go to the peachq Results view, without taking focus",
            "Results go to the console only"
          ],
          "description": "Whether query results also go to the results grid. The console always gets the text.",
          "default": "always",
          "scope": "machine"
        },
        "peachq.peachqArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Arguments added to every peachq the extension starts (the built-in connection, and the REPL when it runs the bundled peachq). Never used for your own q.",
          "default": [
            "-classic"
          ],
          "scope": "machine"
        },
        "peachq.autoFocusOutputOnEntry": {
          "type": "boolean",
          "description": "Reveal the output console when it prints a query result or a log entry",
          "default": true,
          "scope": "machine"
        },
        "peachq.qHomeDirectory": {
          "type": "string",
          "description": "QHOME directory for q runtime",
          "default": "",
          "scope": "machine"
        },
        "peachq.qHomeDirectoryWorkspace": {
          "type": "string",
          "description": "QHOME directory for q runtime for the workspace",
          "default": "",
          "scope": "resource"
        },
        "peachq.neverShowQInstallAgain": {
          "type": "boolean",
          "description": "Never show q install walkthrough again",
          "default": false,
          "scope": "machine"
        },
        "peachq.linting": {
          "type": "boolean",
          "description": "Enable linting",
          "default": false,
          "scope": "resource"
        },
        "peachq.refactoring": {
          "type": "string",
          "enum": [
            "Workspace",
            "Window"
          ],
          "description": "Enable refactoring across files",
          "default": "Workspace",
          "scope": "resource"
        },
        "peachq.connectionMap": {
          "type": "object",
          "description": "Connection map for workspace files",
          "default": {},
          "scope": "resource"
        },
        "peachq.targetMap": {
          "type": "object",
          "description": "Target map for workspace files",
          "default": {},
          "scope": "resource"
        },
        "peachq.timeoutMap": {
          "type": "object",
          "description": "Timeout map for workspace files",
          "default": {},
          "scope": "resource"
        },
        "peachq.defaultTimeout": {
          "type": "number",
          "description": "Timeout in seconds for Insights Enterprise requests",
          "default": 30,
          "scope": "machine-overridable"
        },
        "peachq.connectionLabels": {
          "type": "array",
          "description": "List of label names and colorset",
          "default": [],
          "scope": "machine"
        },
        "peachq.labelsConnectionMap": {
          "type": "array",
          "description": "Labels connection map",
          "default": [],
          "scope": "machine"
        },
        "peachq.notebookRowLimit": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 1000000,
          "description": "Default maximum number of table rows shown in a peachq notebook cell output; each notebook can set its own",
          "scope": "machine-overridable"
        },
        "peachq.notebookRowLimitFrom": {
          "type": "string",
          "enum": [
            "first",
            "last"
          ],
          "enumDescriptions": [
            "Show the first rows of the table",
            "Show the last rows of the table"
          ],
          "default": "first",
          "description": "Default for whether a peachq notebook cell output shows the first or the last rows of a table; each notebook can set its own",
          "scope": "machine-overridable"
        },
        "peachq.deferToKx": {
          "type": "string",
          "enum": [
            "auto",
            "never"
          ],
          "enumDescriptions": [
            "Pause peachq's q features (language server and keybindings) in a window where the KX extension is enabled",
            "Always run peachq's q features, even beside the KX extension"
          ],
          "default": "auto",
          "description": "What peachq does when the KX extension is also enabled",
          "scope": "window"
        }
      }
    },
