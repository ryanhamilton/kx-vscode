  "prettier": {
    "printWidth": 80,
    "bracketSameLine": true,
    "proseWrap": "always"
  },
  "c8": {
    "exclude": [
      "**/test/**/*.*",
      "**/src/models/**/*.*",
      "**/src/classes/**/*.*",
      "**/src/extension.ts"
    ]
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "scripts": {
    "update-deps": "ncu --target patch -u",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint --fix --no-warn-ignored",
    "esbuild-base": "rimraf out && node ./esbuild.mjs",
    "watch": "npm run -S esbuild-base -- --sourcemap --watch",
    "build": "npm run -S esbuild-base -- --sourcemap",
    "vscode:prepublish": "npm run -S esbuild-base -- --minify",
    "package": "vsce package",
    "publish": "vsce publish",
    "pretest": "rimraf out-test && tsc --outdir out-test --strict false",
    "test": "node ./out-test/test/runTest.js",
    "test:file": "cross-env TEST_FILE=$1 npm run test",
    "test:folder": "cross-env TEST_FOLDER=$1 npm run test",
    "pretest:e2e": "npm run build && npm run pretest",
    "test:e2e": "node ./out-test/test/runE2E.js",
    "coverage": "rimraf out && c8 -o coverage-reports -r lcov -r cobertura -r html npm run test",
    "q-test": "bash qcumber.sh -src test/q/main.q -test test/q/tests"
  },
